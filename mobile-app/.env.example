# Copy this file to .env and adjust values, or export these in your shell
# before running `npx expo start`. Expo automatically inlines any variable
# prefixed with EXPO_PUBLIC_ into the JS bundle at build time.

# Base URL of the Student LMS backend's REST API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# "true" (default) = ignore the network entirely and serve every screen from
# the bundled shared/seed-data.json fixtures (src/data/mockData.ts).
# "false" = call the real backend above; the app still transparently falls
# back to mock data per-request if a call fails, so it never dead-ends.
EXPO_PUBLIC_USE_MOCK_DATA=true
